{
    "code-runner.executorMap": {
        "typescript": "tsx"
    },
    "code-runner.runInTerminal": false,
    "code-runner.fileDirectoryAsCwd": true,
    "tailwindCSS.includeLanguages": {
        "typescript": "html"
    },
    "tailwindCSS.experimental.classRegex": [
        ["class=\"([^\"]*)\""],
        ["(?:base|variants)\\s*[:=]\\s*\"([^\"]*)\""]
    ]
}